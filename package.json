{
  "name": "@tightknitai/storybook-addon-slack-block-kit",
  "version": "0.1.2",
  "description": "Storybook 10 addon that renders Slack Block Kit JSON the way Slack would — decorator + panel + toolbar globals (surface/theme) + MDX doc block.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./manager": {
      "types": "./dist/manager.d.ts",
      "import": "./dist/manager.js",
      "require": "./dist/manager.cjs"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "import": "./dist/preset.js",
      "require": "./dist/preset.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup",
    "build:clean": "rm -rf dist && pnpm run build",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "deploy": "pnpm run build-storybook && wrangler deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm run build:clean && pnpm test"
  },
  "dependencies": {
    "@tightknitai/slack-block-kit-validator": "0.1.13",
    "slack-blocks-to-jsx": "^1.0.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "storybook": "^10.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@types/node": "^25.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.6",
    "lefthook": "^2.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.4.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.6",
    "wrangler": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TightknitAI/storybook-addon-slack-block-kit.git"
  },
  "homepage": "https://github.com/TightknitAI/storybook-addon-slack-block-kit",
  "bugs": {
    "url": "https://github.com/TightknitAI/storybook-addon-slack-block-kit/issues"
  },
  "author": "Tightknit <https://tightknit.ai>",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@10.32.1",
  "keywords": [
    "storybook",
    "storybook-addon",
    "storybook-addons",
    "slack",
    "slack-block-kit",
    "block-kit",
    "react",
    "preview",
    "design-system"
  ],
  "storybook": {
    "displayName": "Slack Block Kit",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://avatars.githubusercontent.com/u/192043297"
  }
}
